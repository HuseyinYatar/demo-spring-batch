{
  "id": null,
  "uid": "batchdemo-prometheus-metrics",
  "title": "Batch Metrics (Prometheus)",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Job Runs Recorded",
      "gridPos": { "h": 4, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "batchdemo-prometheus" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "batchdemo-prometheus" },
          "expr": "sum(spring_batch_job_seconds_count)",
          "instant": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "blue", "value": null }]
          },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Max Job Duration (s)",
      "gridPos": { "h": 4, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "batchdemo-prometheus" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "batchdemo-prometheus" },
          "expr": "max(max_over_time(spring_batch_job_seconds_max[$__range]))",
          "instant": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "orange", "value": null }]
          },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Cumulative Job Time (s)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "batchdemo-prometheus" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "batchdemo-prometheus" },
          "expr": "spring_batch_job_seconds_sum",
          "legendFormat": "{{spring_batch_job_name}} ({{spring_batch_job_status}})",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "options": {}
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Cumulative Step Time (s) by Step",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "batchdemo-prometheus" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "batchdemo-prometheus" },
          "expr": "spring_batch_step_seconds_sum",
          "legendFormat": "{{spring_batch_step_name}}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "options": {}
    }
  ]
}
