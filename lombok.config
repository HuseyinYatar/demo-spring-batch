config.stopBubbling = true

# Without these, Lombok's generated constructors (@RequiredArgsConstructor etc.) drop
# @Qualifier/@Value from a field instead of copying it onto the generated constructor
# parameter - Spring never sees the annotation, so it silently resolves the parameter
# by type alone. See CLAUDE.md for two real instances of this (BatchJobController,
# InvoiceAggregationProcessor) before this file existed.
lombok.copyableAnnotations += org.springframework.beans.factory.annotation.Qualifier
lombok.copyableAnnotations += org.springframework.beans.factory.annotation.Value
